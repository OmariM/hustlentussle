{
  "compilerOptions": {
    // tsc is the type checker only; esbuild does all emitting.
    "noEmit": true,
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2020", "dom", "dom.iterable"],
    // Migration posture: new/renamed .ts files are strict; untouched legacy
    // .js rides along in the build unchecked until it is converted.
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["web/js/**/*"],
  "exclude": ["web/js/dist"]
}
