# Copy to .env and fill in real values. .env is gitignored.

# Flask session signing key — generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Postgres credentials for the bundled db container
POSTGRES_USER=hustlentussle
POSTGRES_PASSWORD=
POSTGRES_DB=hustlentussle

# Host port the web container is published on (loopback only).
# 8080 is taken by Domino Soul on this host; 8090 is the default.
WEB_PORT=8090

# Dev environment credentials (docker-compose.dev.yml + scripts/dev-server-start.sh).
# Separate Postgres instance/volume from the prod stack above.
DEV_POSTGRES_USER=hustlentussle_dev
DEV_POSTGRES_PASSWORD=
DEV_POSTGRES_DB=hustlentussle_dev
DEV_POSTGRES_PORT=5433
